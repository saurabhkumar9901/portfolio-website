# Gemini powers live answers on /ask. Without it the site falls back to the
# scripted answers in lib/profile.js.
GEMINI_API_KEY=

# Deepgram powers the avatar's voice (Aura-2). Without it the avatar simply
# stays silent — text, chat and layout are unaffected.
#
# After changing lib/profile.js, regenerate the committed demo clips:
#   node scripts/prerender-audio.mjs
DEEPGRAM_API_KEY=
